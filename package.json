{
  "name": "phishing-forensics-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered Gmail phishing detection Chrome extension with a companion analysis API",
  "workspaces": [
    "backend",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspace=phishing-forensics-extension",
    "dev:backend": "npm run dev --workspace=phishing-forensics-backend",
    "dev:extension": "npm run watch --workspace=phishing-forensics-extension"
  }
}
